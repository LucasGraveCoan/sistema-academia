<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="16.0"
      prefWidth="560.0"
      prefHeight="580.0"
      styleClass="root-container"
      stylesheets="@academia.css"
      xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="com.senai.sistemaacademia.controller.HelloController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <VBox spacing="14.0"
          maxWidth="460.0"
          styleClass="welcome-card">

        <Label text="SISTEMA ACADEMIA"
               styleClass="brand-label"/>

        <Label text="Cadastro de Professor"
               styleClass="title-label"/>

        <Label text="Preencha os dados do novo professor abaixo:"
               styleClass="subtitle-label"/>

        <VBox spacing="6.0">
            <Label text="Nome Completo"
                   styleClass="field-label"/>
            <TextField fx:id="nomeProfessor"
                       promptText="Digite o nome do professor"
                       styleClass="text-field"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="CPF"
                   styleClass="field-label"/>
            <TextField fx:id="cpfProfessor"
                       promptText="000.000.000-00"
                       styleClass="text-field"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Telefone"
                   styleClass="field-label"/>
            <TextField fx:id="telefoneProfessor"
                       promptText="(00) 00000-0000"
                       styleClass="text-field"/>
        </VBox>

        <Button text="Cadastrar Professor"
                onAction="#cadastrarProfessor"
                styleClass="primary-button"
                maxWidth="Infinity"
                prefHeight="44.0"/>

    </VBox>

</VBox>
