
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.senai.sistemaacademia.controller.HelloController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Cadastro de Professor"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <TextField fx:id="nomeProfessor"
               promptText="Nome completo"/>

    <TextField fx:id="cpfProfessor"
               promptText="CPF"/>

    <TextField fx:id="telefoneProfessor"
               promptText="Telefone"/>

    <Button text="Cadastrar Professor"
            onAction="#cadastrarProfessor"
            maxWidth="Infinity"/>

</VBox>

