<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            stylesheets="@academia.css"
            styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.senai.sistemaacademia.controller.DashboardController">

    <VBox spacing="24.0" styleClass="content-area">

        <!-- LINHA DE CARDS DE ESTATÍSTICAS -->
        <HBox spacing="16.0">
            <!-- Card 1: Alunos -->
            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-highlight-blue">
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL DE ALUNOS" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="👥" style="-fx-font-size: 18px;"/>
                </HBox>
                <Label fx:id="totalAlunosLabel" text="0" styleClass="stat-value"/>
                <Label text="Alunos ativos cadastrados" styleClass="stat-trend"/>
            </VBox>

            <!-- Card 2: Professores -->
            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-highlight-emerald">
                <HBox alignment="CENTER_LEFT">
                    <Label text="PROFESSORES" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="👨‍🏫" style="-fx-font-size: 18px;"/>
                </HBox>
                <Label fx:id="totalProfessoresLabel" text="0" styleClass="stat-value"/>
                <Label text="Corpo docente em atividade" styleClass="stat-trend"/>
            </VBox>

            <!-- Card 3: Planos -->
            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-highlight-amber">
                <HBox alignment="CENTER_LEFT">
                    <Label text="PLANOS ATIVOS" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="💳" style="-fx-font-size: 18px;"/>
                </HBox>
                <Label fx:id="totalPlanosLabel" text="0" styleClass="stat-value"/>
                <Label text="Modalidades disponíveis" styleClass="stat-trend"/>
            </VBox>

            <!-- Card 4: Treinos -->
            <VBox HBox.hgrow="ALWAYS" styleClass="stat-card, stat-card-highlight-purple">
                <HBox alignment="CENTER_LEFT">
                    <Label text="FICHAS DE TREINO" styleClass="stat-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="📋" style="-fx-font-size: 18px;"/>
                </HBox>
                <Label fx:id="totalTreinosLabel" text="0" styleClass="stat-value"/>
                <Label text="Treinos personalizados montados" styleClass="stat-trend"/>
            </VBox>
        </HBox>

        <!-- ATALHOS RÁPIDOS -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel">
            <Label text="Ações Rápidas:" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Novo Aluno" onAction="#irParaAlunos" styleClass="btn-primary"/>
            <Button text="+ Montar Treino" onAction="#irParaTreinos" styleClass="btn-info"/>
            <Button text="+ Consultar Professores" onAction="#irParaProfessores" styleClass="btn-secondary"/>
        </HBox>

        <!-- SEÇÃO DE TABELAS RECENTES -->
        <HBox spacing="18.0">
            <!-- Tabela: Alunos Recentes -->
            <VBox HBox.hgrow="ALWAYS" spacing="12.0" styleClass="card-panel">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label text="Últimos Alunos Matriculados" styleClass="card-title"/>
                        <Label text="Demonstração ilustrativa de registros recentes" styleClass="card-description"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ver Todos →" onAction="#irParaAlunos" styleClass="btn-secondary"/>
                </HBox>

                <TableView fx:id="tabelaAlunosRecentes" prefHeight="220.0">
                    <columns>
                        <TableColumn fx:id="colAlunoNome" text="Aluno" prefWidth="180.0"/>
                        <TableColumn fx:id="colAlunoPlano" text="Plano" prefWidth="130.0"/>
                        <TableColumn fx:id="colAlunoProfessor" text="Professor" prefWidth="150.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Tabela: Treinos Recentes -->
            <VBox HBox.hgrow="ALWAYS" spacing="12.0" styleClass="card-panel">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label text="Fichas de Treino Recentes" styleClass="card-title"/>
                        <Label text="Últimas rotinas criadas para alunos" styleClass="card-description"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ver Todos →" onAction="#irParaTreinos" styleClass="btn-secondary"/>
                </HBox>

                <TableView fx:id="tabelaTreinosRecentes" prefHeight="220.0">
                    <columns>
                        <TableColumn fx:id="colTreinoNome" text="Nome do Treino" prefWidth="170.0"/>
                        <TableColumn fx:id="colTreinoAluno" text="Aluno" prefWidth="150.0"/>
                        <TableColumn fx:id="colTreinoObjetivo" text="Objetivo" prefWidth="140.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
