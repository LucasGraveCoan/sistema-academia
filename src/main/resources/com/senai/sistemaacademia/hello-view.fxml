<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18.0"
      prefWidth="900.0"
      prefHeight="600.0"
      styleClass="root-container"
      stylesheets="@academia.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.senai.sistemaacademia.controller.HelloController">

    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
    </padding>

    <VBox alignment="CENTER"
          spacing="12.0"
          maxWidth="560.0"
          styleClass="welcome-card">

        <Label text="SISTEMA ACADEMIA"
               styleClass="brand-label"/>

        <Region minHeight="12.0" prefHeight="12.0"/>

        <Label text="Olá, seja bem-vindo!"
               styleClass="title-label"
               wrapText="true"/>

        <Label fx:id="welcomeText"
               text="Seu próximo nível começa aqui."
               styleClass="subtitle-label"
               wrapText="true"/>

        <Region minHeight="12.0" prefHeight="12.0"/>

        <Button text="Entrar no sistema"
                onAction="#cadastrarProfessor"
                styleClass="primary-button"
                defaultButton="true"
                maxWidth="260.0"
                prefHeight="48.0"/>

        <HBox alignment="CENTER" spacing="6.0">
            <Region minWidth="4.0" minHeight="4.0"
                    prefWidth="4.0" prefHeight="4.0"
                    styleClass="status-dot"/>

            <Label text="GESTÃO • DESEMPENHO • EVOLUÇÃO"
                   styleClass="footer-label"/>
        </HBox>

    </VBox>

    <Label text="SISTEMA DE GERENCIAMENTO DE ACADEMIA"
           styleClass="bottom-label"/>

</VBox>
