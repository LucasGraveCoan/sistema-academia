<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            stylesheets="@academia.css"
            styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.senai.sistemaacademia.controller.PlanosController">

    <VBox spacing="20.0" styleClass="content-area">

        <!-- PAINEL DE FORMULÁRIO -->
        <VBox spacing="16.0" styleClass="card-panel">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="💳" style="-fx-font-size: 18px;"/>
                <VBox spacing="2.0">
                    <Label text="Configuração do Plano de Matrícula" styleClass="card-title"/>
                    <Label text="Definição de modalidades, vigência e precificação para os alunos" styleClass="card-description"/>
                </VBox>
            </HBox>

            <!-- Grid de Campos -->
            <GridPane hgap="14.0" vgap="12.0">
                <!-- Coluna 0: ID -->
                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="90.0">
                    <Label text="Código" styleClass="field-label"/>
                    <TextField fx:id="idField" promptText="Auto" editable="false" style="-fx-opacity: 0.6;"/>
                </VBox>

                <!-- Coluna 1: Nome do Plano -->
                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2" HBox.hgrow="ALWAYS">
                    <HBox spacing="2.0">
                        <Label text="Nome do Plano" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="nomeField" promptText="Ex: Plano Semestral Pro"/>
                </VBox>

                <!-- Coluna 3: Modalidade -->
                <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="240.0">
                    <HBox spacing="2.0">
                        <Label text="Modalidade" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <ComboBox fx:id="modalidadeCombo" promptText="Selecione a modalidade..." maxWidth="Infinity"/>
                </VBox>

                <!-- Linha 1 -->
                <!-- Duração em Meses -->
                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <HBox spacing="2.0">
                        <Label text="Duração (em meses)" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="duracaoField" promptText="Ex: 1, 3, 6 ou 12"/>
                </VBox>

                <!-- Valor da Mensalidade -->
                <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <HBox spacing="2.0">
                        <Label text="Valor (R$)" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="valorField" promptText="Ex: 129.90"/>
                </VBox>
            </GridPane>

            <!-- Barra de Botões -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 8px 0 0 0;">
                <Button text="+ Novo" onAction="#novo" styleClass="btn-success"/>
                <Button text="💾 Salvar" onAction="#salvar" styleClass="btn-primary"/>
                <Button text="✏️ Editar" onAction="#editar" styleClass="btn-warning"/>
                <Button text="🗑️ Excluir" onAction="#excluir" styleClass="btn-danger"/>
                <Button text="🧹 Limpar" onAction="#limpar" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- PAINEL DA TABELA -->
        <VBox spacing="14.0" styleClass="card-panel">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="2.0">
                    <Label text="Planos Disponíveis" styleClass="card-title"/>
                    <Label text="Tabela de planos vigentes e cadastrados no sistema" styleClass="card-description"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Busca -->
                <HBox spacing="8.0" alignment="CENTER_RIGHT">
                    <TextField fx:id="buscaField" promptText="Buscar plano ou modalidade..." prefWidth="250.0"/>
                    <Button text="🔍 Buscar" onAction="#buscar" styleClass="btn-secondary"/>
                </HBox>
            </HBox>

            <!-- Tabela -->
            <TableView fx:id="tabelaPlanos" prefHeight="290.0">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
                    <TableColumn fx:id="colNome" text="Nome do Plano" prefWidth="250.0"/>
                    <TableColumn fx:id="colModalidade" text="Modalidade Inclusa" prefWidth="280.0"/>
                    <TableColumn fx:id="colDuracao" text="Duração (meses)" prefWidth="150.0"/>
                    <TableColumn fx:id="colValor" text="Valor Mensal (R$)" prefWidth="160.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
