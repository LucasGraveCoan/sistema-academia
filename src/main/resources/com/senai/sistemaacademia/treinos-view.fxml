<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            stylesheets="@academia.css"
            styleClass="scroll-pane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.senai.sistemaacademia.controller.TreinosController">

    <VBox spacing="20.0" styleClass="content-area">

        <!-- PAINEL 1: IDENTIFICAÇÃO DO TREINO -->
        <VBox spacing="16.0" styleClass="card-panel">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="📋" style="-fx-font-size: 18px;"/>
                <VBox spacing="2.0">
                    <Label text="Identificação da Ficha de Treino" styleClass="card-title"/>
                    <Label text="Associe o treino ao aluno e ao professor responsável" styleClass="card-description"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="8.0">
                    <Button text="🔍 Consultar Treino" onAction="#consultarTreino" styleClass="btn-info"/>
                    <Button text="📜 Histórico de Treinos" onAction="#historicoTreinos" styleClass="btn-secondary"/>
                </HBox>
            </HBox>

            <!-- Grid de Campos Principais -->
            <GridPane hgap="14.0" vgap="12.0">
                <!-- Coluna 0: ID -->
                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="90.0">
                    <Label text="Código" styleClass="field-label"/>
                    <TextField fx:id="idTreinoField" promptText="Auto" editable="false" style="-fx-opacity: 0.6;"/>
                </VBox>

                <!-- Coluna 1: Nome do Treino -->
                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2" HBox.hgrow="ALWAYS">
                    <HBox spacing="2.0">
                        <Label text="Nome / Identificação do Treino" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="nomeTreinoField" promptText="Ex: Treino A - Hipertrofia Peito &amp; Tríceps"/>
                </VBox>

                <!-- Coluna 3: Objetivo -->
                <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="250.0">
                    <Label text="Objetivo do Treino" styleClass="field-label"/>
                    <TextField fx:id="objetivoField" promptText="Ex: Hipertrofia / Definição"/>
                </VBox>

                <!-- Linha 1 -->
                <!-- Aluno -->
                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <HBox spacing="2.0">
                        <Label text="Aluno" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <ComboBox fx:id="alunoCombo" promptText="Selecione o aluno..." maxWidth="Infinity"/>
                </VBox>

                <!-- Professor Responsável -->
                <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <HBox spacing="2.0">
                        <Label text="Professor Responsável" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <ComboBox fx:id="professorCombo" promptText="Selecione o professor..." maxWidth="Infinity"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- PAINEL 2: ADICIONAR EXERCÍCIOS AO TREINO -->
        <VBox spacing="16.0" styleClass="card-panel">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="➕" style="-fx-font-size: 16px;"/>
                <VBox spacing="2.0">
                    <Label text="Adicionar Exercício ao Treino" styleClass="card-title"/>
                    <Label text="Defina os movimentos, quantidade de séries, repetições e carga recomendada" styleClass="card-description"/>
                </VBox>
            </HBox>

            <!-- Linha de Adição de Exercício -->
            <GridPane hgap="12.0" vgap="10.0">
                <!-- Seleção do Exercício -->
                <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="280.0">
                    <HBox spacing="2.0">
                        <Label text="Exercício" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <ComboBox fx:id="exercicioCombo" promptText="Selecione o exercício..." maxWidth="Infinity"/>
                </VBox>

                <!-- Séries -->
                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="90.0">
                    <HBox spacing="2.0">
                        <Label text="Séries" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="seriesField" promptText="Ex: 4"/>
                </VBox>

                <!-- Repetições -->
                <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0" prefWidth="90.0">
                    <HBox spacing="2.0">
                        <Label text="Repetições" styleClass="field-label"/>
                        <Label text="*" styleClass="field-label-required"/>
                    </HBox>
                    <TextField fx:id="repeticoesField" promptText="Ex: 10"/>
                </VBox>

                <!-- Carga (kg) -->
                <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="100.0">
                    <Label text="Carga (kg)" styleClass="field-label"/>
                    <TextField fx:id="cargaField" promptText="Ex: 25.0"/>
                </VBox>

                <!-- Observação -->
                <VBox spacing="4.0" GridPane.columnIndex="4" GridPane.rowIndex="0" HBox.hgrow="ALWAYS">
                    <Label text="Observação / Descanso" styleClass="field-label"/>
                    <TextField fx:id="observacaoField" promptText="Ex: Descanso de 60s, cadência 2-0-2"/>
                </VBox>

                <!-- Botão Adicionar Exercício -->
                <VBox spacing="4.0" alignment="BOTTOM_LEFT" GridPane.columnIndex="5" GridPane.rowIndex="0">
                    <Button text="➕ Adicionar" onAction="#adicionarExercicio" styleClass="btn-primary" prefHeight="38.0"/>
                </VBox>
            </GridPane>

            <!-- Tabela de Exercícios do Treino -->
            <VBox spacing="8.0" style="-fx-padding: 8px 0 0 0;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Exercícios na Ficha de Treino" styleClass="field-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🗑️ Remover Exercício Selecionado" onAction="#removerExercicio" styleClass="btn-danger"/>
                </HBox>

                <TableView fx:id="tabelaItensTreino" prefHeight="220.0">
                    <columns>
                        <TableColumn fx:id="colExercicio" text="Exercício" prefWidth="250.0"/>
                        <TableColumn fx:id="colGrupo" text="Grupo Muscular" prefWidth="180.0"/>
                        <TableColumn fx:id="colSeries" text="Séries" prefWidth="80.0"/>
                        <TableColumn fx:id="colRepeticoes" text="Repetições" prefWidth="100.0"/>
                        <TableColumn fx:id="colCarga" text="Carga (kg)" prefWidth="100.0"/>
                        <TableColumn fx:id="colObs" text="Observações / Cadência" prefWidth="240.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Ações Gerais do Treino -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10px 0 0 0;">
                <Button text="+ Novo Treino" onAction="#novoTreino" styleClass="btn-success"/>
                <Button text="💾 Salvar Treino" onAction="#salvarTreino" styleClass="btn-primary"/>
                <Button text="✏️ Editar Treino" onAction="#editarTreino" styleClass="btn-warning"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
